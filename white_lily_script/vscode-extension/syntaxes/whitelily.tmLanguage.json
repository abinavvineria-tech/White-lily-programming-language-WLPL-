{
  "name": "White Lily Script",
  "scopeName": "source.wlily",
  "fileTypes": ["wlily"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#builtins" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "match": "#.*$", "name": "comment.line.number-sign.wlily" }
      ]
    },
    "strings": {
      "patterns": [
        { "begin": "\"", "end": "\"", "name": "string.quoted.double.wlily" },
        { "begin": "'", "end": "'", "name": "string.quoted.single.wlily" }
      ]
    },
    "numbers": {
      "patterns": [
        { "match": "\\b\\d+\\.\\d*\\b", "name": "constant.numeric.float.wlily" },
        { "match": "\\b\\d+\\b", "name": "constant.numeric.integer.wlily" }
      ]
    },
    "keywords": {
      "patterns": [
        { "match": "\\b(bloom|flower|blossom|garden|petal|vine|dew)\\b", "name": "keyword.control.wlily" },
        { "match": "\\b(if|elif|else)\\b", "name": "keyword.control.wlily" },
        { "match": "\\b(and|or|not)\\b", "name": "keyword.operator.logical.wlily" },
        { "match": "\\b(true|false)\\b", "name": "constant.language.wlily" },
        { "match": "\\bnone\\b", "name": "constant.language.wlily" }
      ]
    },
    "types": {
      "patterns": [
        { "match": "\\b(lily|crystal|bloom_type|garden)\\b", "name": "storage.type.wlily" }
      ]
    },
    "builtins": {
      "patterns": [
        { "match": "\\b(len|range|type|int|str|float|sleep|randint|sqrt)\\b", "name": "support.function.wlily" }
      ]
    },
    "operators": {
      "patterns": [
        { "match": "[+\\-*/%=<>!]+|\\.\\.", "name": "keyword.operator.wlily" }
      ]
    }
  }
}
